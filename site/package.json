{
  "name": "code-context-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Code Context (cctx) official website & documentation — Astro Starlight + Dual-Layer Motion Stage for GitHub Pages.",
  "scripts": {
    "predev": "node scripts/gen-og-image.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "gen-og": "node scripts/gen-og-image.mjs",
    "check": "astro check",
    "build": "NODE_ENV=production node scripts/gen-og-image.mjs && NODE_ENV=production astro build && NODE_ENV=production node scripts/build-seo-geo.mjs",
    "build:seo": "NODE_ENV=production node scripts/build-seo-geo.mjs",
    "check:seo": "NODE_ENV=production node scripts/check-seo-geo.mjs",
    "check:live": "NODE_ENV=production node scripts/check-seo-geo.mjs --url",
    "test": "node --test scripts/seo-geo.test.mjs",
    "test:browser": "playwright test",
    "serve:agents": "NODE_ENV=production node scripts/serve-agents.mjs",
    "submit:indexing": "NODE_ENV=production node scripts/submit-indexing.mjs",
    "preview": "NODE_ENV=production astro preview",
    "astro": "astro"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@playwright/test": "^1.56.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.36.0",
    "astro": "^5.14.0",
    "fast-xml-parser": "^5.3.0",
    "parse5": "^8.1.1",
    "sharp": "^0.34.0"
  }
}
