---
const route = Astro.locals.starlightRoute;
const { head, entry, id, siteTitle } = route;
const data = entry?.data ?? {};

const SITE_ORIGIN = (Astro.site ? Astro.site.origin : "https://dotnetpower.github.io").replace(/\/$/, "");
const BASE_URL = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const SITE_ROOT_URL = `${SITE_ORIGIN}${BASE_URL}`;

const is404 = id === "404" || Astro.url.pathname.endsWith("/404") || Astro.url.pathname.endsWith("/404/");
const isHome = id === "" || id === "index";

const canonicalEntry = head.find((item) => item.tag === "link" && item.attrs?.rel === "canonical");
const rawCanonical = typeof canonicalEntry?.attrs?.href === "string"
  ? canonicalEntry.attrs.href
  : new URL(Astro.url.pathname, SITE_ORIGIN).href;
const canonicalHref = rawCanonical.endsWith("/") || /\.[a-z0-9]+$/i.test(rawCanonical)
  ? rawCanonical
  : `${rawCanonical}/`;

const cleanSlug = id.replace(/\/index$/, "").replace(/^index$/, "");
const markdownMirrorHref = isHome
  ? `${SITE_ROOT_URL}index.md`
  : `${SITE_ROOT_URL}${cleanSlug}.md`;

const defaultDescription =
  "Code Context (cctx): local Rust source indexing and block-clamped context for AI coding agents, with native VS Code tools and MCP.";

const finalDescription = String(data.description || defaultDescription).replace(/\s+/g, " ").trim();

const seoKeywords =
  "Code Context, cctx, pctx, VS Code Language Model Tools, GitHub Copilot extension, MCP server, Model Context Protocol, code search, trigram index, Rust coding agent, context engineering, token optimization, agent-tokenomics, block clamping";

let finalTitle: string;
if (isHome) {
  finalTitle = String(data.title || siteTitle);
} else if (is404) {
  finalTitle = `404 — Page Not Found | ${siteTitle}`;
} else {
  const pageTitle = String(data.title || siteTitle).trim();
  finalTitle = pageTitle.toLowerCase().includes("code context") || pageTitle.toLowerCase().includes("cctx")
    ? pageTitle
    : `${pageTitle} | ${siteTitle}`;
}

const ogImageUrl = `${SITE_ROOT_URL}og-cover.png`;
const ogImageAlt =
  "Code Context (cctx) — Find the signal, clamp the noise in 0.23 ms. 17.22× faster warm retrieval, -73% to -91% lookup tokens, Native VS Code Tools + MCP in Rust.";

const googleSiteVerification =
  import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || "jHE9O63_qT7gVGACSA-OA_2d1wzkue6urJ99MGSCzY8";
const naverSiteVerification = import.meta.env.PUBLIC_NAVER_SITE_VERIFICATION;

// Remove duplicate tags emitted by Starlight before inserting normalized SEO/GEO/AEO tags.
const filteredHead = head.filter((item) => {
  if (item.tag === "title") return false;
  if (item.tag === "link" && (item.attrs?.rel === "canonical" || item.attrs?.rel === "sitemap")) return false;
  if (item.tag === "meta") {
    if (item.attrs?.charset !== undefined) return false;
    const key = String(item.attrs?.name || item.attrs?.property || "");
    if (
      [
        "viewport",
        "description",
        "keywords",
        "robots",
        "google-site-verification",
        ...(naverSiteVerification ? ["naver-site-verification"] : []),
        "og:title",
        "og:description",
        "og:url",
        "og:type",
        "og:site_name",
        "og:locale",
        "og:image",
        "og:image:secure_url",
        "og:image:type",
        "og:image:width",
        "og:image:height",
        "og:image:alt",
        "twitter:card",
        "twitter:title",
        "twitter:description",
        "twitter:image",
        "twitter:image:alt",
      ].includes(key)
    ) {
      return false;
    }
  }
  return true;
});

const verifiedDateStr = data.verified instanceof Date && !Number.isNaN(data.verified.valueOf())
  ? data.verified.toISOString().slice(0, 10)
  : "2026-11-14";
const publishedIso = `${verifiedDateStr}T00:00:00Z`;
const modifiedIso = "2026-11-14T03:00:00Z";

const orgNode = {
  "@type": "Organization",
  "@id": `${SITE_ROOT_URL}#organization`,
  name: "dotnetpower",
  url: SITE_ROOT_URL,
  logo: {
    "@type": "ImageObject",
    url: ogImageUrl,
    width: 1200,
    height: 630,
  },
  sameAs: [
    "https://github.com/dotnetpower/code-context",
    "https://marketplace.visualstudio.com/items?itemName=dotnetpower.code-context-native",
  ],
};

const websiteNode = {
  "@type": "WebSite",
  "@id": `${SITE_ROOT_URL}#website`,
  url: SITE_ROOT_URL,
  name: "Code Context (cctx)",
  alternateName: ["cctx", "code-context", "dotnetpower.code-context-native", "pctx"],
  keywords: seoKeywords,
  description: defaultDescription,
  inLanguage: "en-US",
  publisher: { "@id": `${SITE_ROOT_URL}#organization` },
};

const webpageNode = {
  "@type": "WebPage",
  "@id": `${canonicalHref}#webpage`,
  url: canonicalHref,
  name: finalTitle,
  description: finalDescription,
  inLanguage: "en-US",
  isPartOf: { "@id": `${SITE_ROOT_URL}#website` },
  publisher: { "@id": `${SITE_ROOT_URL}#organization` },
  mainEntityOfPage: { "@id": canonicalHref },
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: ogImageUrl,
    width: 1200,
    height: 630,
  },
  datePublished: publishedIso,
  dateModified: modifiedIso,
};

const softwareNode = {
  "@type": "SoftwareApplication",
  "@id": `${SITE_ROOT_URL}#software`,
  name: "Code Context (cctx)",
  description:
    "Fast local file discovery, trigram-indexed source search, smart block-clamped context cache, declarative probes (pctx), and compaction continuity journal for AI coding agents.",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux, Windows, WSL, SSH",
  url: SITE_ROOT_URL,
  downloadUrl: "https://marketplace.visualstudio.com/items?itemName=dotnetpower.code-context-native",
  codeRepository: "https://github.com/dotnetpower/code-context",
  license: "https://opensource.org/licenses/MIT",
  publisher: { "@id": `${SITE_ROOT_URL}#organization` },
};

const graphNodes: Record<string, unknown>[] = [orgNode, websiteNode, webpageNode];

if (isHome) {
  graphNodes.push(softwareNode);
} else if (!is404) {
  graphNodes.push({
    "@type": "TechArticle",
    "@id": `${canonicalHref}#article`,
    headline: String(data.title || finalTitle),
    description: finalDescription,
    keywords: seoKeywords,
    image: [ogImageUrl],
    url: canonicalHref,
    inLanguage: "en-US",
    author: { "@id": `${SITE_ROOT_URL}#organization` },
    publisher: { "@id": `${SITE_ROOT_URL}#organization` },
    isPartOf: { "@id": `${SITE_ROOT_URL}#website` },
    about: { "@id": `${SITE_ROOT_URL}#software` },
    mainEntityOfPage: { "@id": canonicalHref },
    datePublished: publishedIso,
    dateModified: modifiedIso,
  });

  graphNodes.push({
    "@type": "BreadcrumbList",
    "@id": `${canonicalHref}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Code Context (cctx)",
        item: SITE_ROOT_URL,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: String(data.title || finalTitle),
        item: canonicalHref,
      },
    ],
  });
}

const jsonLdString = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graphNodes,
})
  .replace(/</g, "\\u003c")
  .replace(/\u2028/g, "\\u2028")
  .replace(/\u2029/g, "\\u2029");
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{finalTitle}</title>
<meta name="description" content={finalDescription} />
<meta name="keywords" content={seoKeywords} />
<meta
  name="robots"
  content={is404
    ? "noindex, nofollow"
    : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
/>
{googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
{naverSiteVerification && <meta name="naver-site-verification" content={naverSiteVerification} />}
<meta name="theme-color" content="#0b0e18" />
<meta name="application-name" content="Code Context (cctx)" />
<link rel="canonical" href={canonicalHref} />
<link rel="sitemap" type="application/xml" href={`${SITE_ROOT_URL}sitemap-index.xml`} />
<link rel="sitemap" type="application/xml" href={`${SITE_ROOT_URL}sitemap.xml`} />
<link
  rel="alternate"
  type="application/rss+xml"
  href={`${SITE_ROOT_URL}rss.xml`}
  title="Code Context (cctx) Documentation RSS Feed"
/>
<link
  rel="alternate"
  type="text/plain"
  href={`${SITE_ROOT_URL}llms.txt`}
  title="LLM-friendly documentation index (llms.txt)"
/>
<link
  rel="alternate"
  type="text/plain"
  href={`${SITE_ROOT_URL}llms-full.txt`}
  title="Full documentation corpus for LLMs (llms-full.txt)"
/>
{!is404 && (
  <link
    rel="alternate"
    type="text/markdown"
    href={markdownMirrorHref}
    title="Markdown edition of this page"
  />
)}

<meta property="og:title" content={finalTitle} />
<meta property="og:description" content={finalDescription} />
<meta property="og:url" content={canonicalHref} />
<meta property="og:site_name" content="Code Context (cctx)" />
<meta property="og:type" content={isHome ? "website" : "article"} />
<meta property="og:locale" content="en_US" />
{!is404 && <meta property="article:published_time" content={publishedIso} />}
{!is404 && <meta property="article:modified_time" content={modifiedIso} />}
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:secure_url" content={ogImageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={finalTitle} />
<meta name="twitter:description" content={finalDescription} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />

{filteredHead.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}

{!is404 && <script type="application/ld+json" set:html={jsonLdString} />}
