<section class="lookup-budget" aria-labelledby="lookup-budget-heading">
  <h2 id="lookup-budget-heading">Check your lookup payload reduction</h2>
  <p>Enter token counts from your own tool outputs. This arithmetic is not a forecast of billing or performance.</p>
  <form id="lookup-budget">
    <label>Baseline tokens <input name="baseline" type="number" min="1" step="1" required value="200" /></label>
    <label>Clamped tokens <input name="clamped" type="number" min="0" step="1" required value="50" /></label>
    <button type="submit" class="cctx-btn cctx-btn-primary">Calculate reduction</button>
    <output aria-live="polite">Example inputs only. Submit to calculate.</output>
  </form>
  <noscript>The calculator requires JavaScript. Formula: (baseline − clamped) ÷ baseline × 100%.</noscript>
</section>
<script>
  const form = document.querySelector<HTMLFormElement>("#lookup-budget");
  if (form) form.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const baseline = Number(data.get("baseline"));
    const clamped = Number(data.get("clamped"));
    const output = form.querySelector("output");
    if (!output) throw new Error("Lookup calculator output is missing");
    if (!Number.isSafeInteger(baseline) || baseline <= 0 || !Number.isSafeInteger(clamped) || clamped < 0) {
      output.value = "Enter whole token counts: baseline above zero and clamped zero or greater.";
      return;
    }
    const reduction = (baseline - clamped) / baseline * 100;
    output.value = `${reduction.toFixed(1)}% payload reduction (${baseline - clamped} tokens). Negative values mean a larger output, not savings.`;
  });
</script>
<style>
  .lookup-budget {
    min-height: 20rem;
    contain: layout;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border: 1px solid var(--cctx-border-soft);
    border-radius: .95rem;
    background: var(--cctx-surface-card);
  }
  h2 { margin: 0; color: var(--sl-color-white); font-size: clamp(1.25rem, 2vw, 1.5rem); line-height: 1.3; }
  p { margin: .6rem 0 1.25rem; color: var(--sl-color-gray-2); line-height: 1.6; }
  form { display: grid; grid-template-columns: repeat(2, minmax(0, 10rem)) max-content; gap: 1rem; align-items: end; }
  label { display: grid; gap: .4rem; min-width: 0; color: var(--sl-color-gray-2); font-size: .88rem; }
  input {
    width: 100%;
    min-width: 0;
    min-height: 3rem;
    padding: .65rem .8rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: .6rem;
    font: inherit;
    color: var(--sl-color-white);
    background: var(--cctx-surface-card);
  }
  button { min-height: 3rem; cursor: pointer; }
  input:focus-visible, button:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 3px; }
  output {
    display: block;
    grid-column: 1 / -1;
    min-width: 0;
    height: 8rem;
    contain: layout;
    overflow: auto;
    overflow-wrap: anywhere;
    padding: .85rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: .6rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    font-size: .88rem;
    line-height: 1.6;
  }
  @media (max-width: 40rem) {
    form { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    button { grid-column: 1 / -1; }
  }
</style>
