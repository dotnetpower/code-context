[
  {"name":"decorator","pattern":"^@[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*","regex":true},
  {"name":"typing_optional","pattern":"Optional\\[[A-Za-z_][^\\]]*\\]","regex":true},
  {"name":"path_constructor","pattern":"Path\\([^\\n]*\\)","regex":true},
  {"name":"json_load","pattern":"json\\.(?:load|loads)\\(","regex":true},
  {"name":"env_lookup","pattern":"os\\.environ(?:\\.get|\\[)","regex":true},
  {"name":"except_clause","pattern":"^\\s*except\\s+(?:Exception|[A-Za-z_]+Error)","regex":true},
  {"name":"with_open","pattern":"with\\s+open\\([^\\n]+\\)\\s+as\\s+\\w+","regex":true},
  {"name":"return_none","pattern":"\\breturn\\s+None\\b","regex":true},
  {"name":"fastapi_route","pattern":"@router\\.(?:get|post|put|delete|patch)\\(","regex":true},
  {"name":"status_code","pattern":"status_code\\s*=\\s*[0-9]{3}","regex":true},
  {"name":"camel_case","pattern":"\\b[A-Z][a-z]+(?:[A-Z][a-z]+)+\\b","regex":true},
  {"name":"snake_assignment","pattern":"^[a-z_][a-z0-9_]*\\s*=","regex":true},
  {"name":"quoted_error","pattern":"[\"'][^\"']*(?:error|failed)[^\"']*[\"']","regex":true,"ignore_case":true},
  {"name":"relative_import","pattern":"^from\\s+\\.{1,3}[A-Za-z_]","regex":true},
  {"name":"future_annotations","pattern":"from\\s+__future__\\s+import\\s+annotations","regex":true},
  {"name":"main_guard","pattern":"if\\s+__name__\\s*==\\s*[\"']__main__[\"']","regex":true},
  {"name":"case_provider","pattern":"BEARER_TOKEN_PROVIDER","ignore_case":true},
  {"name":"case_settings","pattern":"AZURE_OPENAI_DEPLOYMENT_NAME","ignore_case":true},
  {"name":"case_valueerror","pattern":"VALUEERROR","ignore_case":true},
  {"name":"case_unicode_kelvin","pattern":"k","ignore_case":true},
  {"name":"alternation_weak_branch","pattern":"(?:get_azure|[0-9]+)","regex":true},
  {"name":"optional_literal","pattern":"(?:async\\s+)?def","regex":true},
  {"name":"repeated_literal","pattern":"(?:test_){1,3}[a-z_]+","regex":true},
  {"name":"word_boundary","pattern":"\\bconfiguration\\b","regex":true},
  {"name":"look_anchor","pattern":"\\Afrom\\s+","regex":true},
  {"name":"text_end","pattern":"[^\\n]+\\z","regex":true},
  {"name":"character_class","pattern":"^[A-Fa-f0-9]{8,}$","regex":true},
  {"name":"unicode_word","pattern":"^\\p{L}+$","regex":true},
  {"name":"punctuation_only","pattern":"^[[:punct:]]+$","regex":true},
  {"name":"nested_alternation","pattern":"(?:logger\\.(?:info|error)|print)\\(","regex":true},
  {"name":"tests_scoped","pattern":"^class\\s+Test\\w+","regex":true,"paths":["tests"],"glob":"*.py"},
  {"name":"frontend_scoped","pattern":"(?:interface|type)\\s+[A-Z]\\w+","regex":true,"paths":["frontend"],"glob":"*.ts"}
]
